@model eCommerce2.Models.ListViewModel

<div class="filter--container">
    <div class="filter--title">
        Cinsiyet
    </div>
    <div class="filter--buttons">
        @{
            foreach (var button in Model.filterList.GenderButtons)
            {
                @Html.ActionLink(button.displayName, "List", "Product", new
                {
                    gender = button.linkParams[0],
                category = button.linkParams[1],
                size = button.linkParams[2]
                }, new { @class = button.className })
                ;
            }
        }
    </div>
</div>
