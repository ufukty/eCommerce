<nav class="navbar navbar-expand-lg navbar-light bg-light">
    <div class="container">
        @Html.ActionLink("ETİC", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarColor03" aria-controls="navbarColor03" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarColor03">
            <ul class="navbar-nav mr-auto">
                <li class="nav-item">
                    @Html.ActionLink("KADIN", "List", "Product", new { gender = "-women" }, new { @class = "nav-link" })
                </li>
                <li class="nav-item">
                    @Html.ActionLink("ERKEK", "List", "Product", new { gender = "-men" }, new { @class = "nav-link" })
                </li>
                <li class="nav-item">
                    @Html.ActionLink("ÇOCUK", "List", "Product", new { gender = "-boys-girls" }, new { @class = "nav-link" })
                </li>
            </ul>
            @using Microsoft.AspNet.Identity
            @if (Request.IsAuthenticated)
            {
                using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "navbar-right" }))
                {
                    @Html.AntiForgeryToken()
                    <ul class="navbar-nav mr">
                        <li class="nav-item">@Html.ActionLink("Sepet", "Index", "Cart", routeValues: null, htmlAttributes: new { title = "Sepet", @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("YÖNETİM", "Index", "Manage", routeValues: null, htmlAttributes: new { title = "Yönet", @class = "nav-link" })</li>
                        <li class="nav-item"><a class="nav-link" href="javascript:document.getElementById('logoutForm').submit()">Oturumu kapat</a></li>
                    </ul>
                }
            }
            else
            {
                <ul class="navbar-nav">
                    <li class="nav-item">@Html.ActionLink("Kaydol", "Register", "Account", routeValues: null, htmlAttributes: new { id = "registerLink", @class = "nav-link" })</li>
                    <li class="nav-item active">@Html.ActionLink("Oturum aç", "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink", @class = "nav-link" })</li>
                </ul>
            }

        </div>
    </div>
</nav>
